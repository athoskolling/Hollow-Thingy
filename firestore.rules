rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write/delete their own progress document.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'updatedAt', 'v'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 600000
        && request.resource.data.updatedAt is string;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
